<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Relative to the application working directory. Override with LOG_DIR if needed. -->
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

    <springProperty
            scope="context"
            name="app"
            source="spring.application.name"
            defaultValue="event-ticket-booking"/>

    <!-- Main log file: logs/event-ticket-booking.json -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/event-ticket-booking.json</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/event-ticket-booking.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>eventLogId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"app":"${app}"}</customFields>
        </encoder>
    </appender>

    <!-- Console output is retained so logs remain visible in IntelliJ. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>eventLogId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"app":"${app}"}</customFields>
        </encoder>
    </appender>

    <!-- INFO, WARN and ERROR logs from the application and libraries are written to both. -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>