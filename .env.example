
# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5433/eventticketdb
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password

# JWT signing secret: use a securely generated secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=60m
JWT_ISSUER=event-ticket-booking

# Disable demo-user seeding by default.
SEED_DEMO_USERS=false
